diff --git a/zig/src/core/prompt_cache_lifetime.zig b/zig/src/core/prompt_cache_lifetime.zig
index e7a6a38e..a69eec7 100644
--- a/zig/src/core/prompt_cache_lifetime.zig
+++ b/zig/src/core/prompt_cache_lifetime.zig
@@ -12,9 +12,18 @@ pub fn expired(s: *pc.Store, saved: pc.Saved) void {
 
 /// Reclaim invalid entries between backend operations, keeping every outstanding lookup alive.
 pub fn collect(s: *pc.Store) void {
+    const now = if (s.ttl_s > 0) pc.nowS() else 0;
     var i: usize = 0;
     while (i < s.entries.items.len) {
         const e = s.entries.items[i];
+        // TF_PROMPT_CACHE_TTL_S: a state nobody resumed for this long goes, whatever room is left. A long
+        // conversation that was put down holds GiB the live ones need, and LRU only frees it under pressure.
+        if (!e.expired and s.ttl_s > 0 and e.used_s > 0 and now > e.used_s and now - e.used_s > s.ttl_s) {
+            // A demotion, not an invalidation: the state leaves the device cache but is staged to the disk store
+            // first (remove() reads e.idle), so the next turn reads it back in seconds instead of refilling it.
+            e.expired = true;
+            e.idle = true;
+        }
         if (e.expired and e.borrowers == 0) s.remove(i) else i += 1;
     }
 }
