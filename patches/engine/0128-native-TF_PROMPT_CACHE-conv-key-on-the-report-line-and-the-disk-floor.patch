diff --git a/zig/src/core/prompt_cache.zig b/zig/src/core/prompt_cache.zig
index fc93beb..b28b7d2 100644
--- a/zig/src/core/prompt_cache.zig
+++ b/zig/src/core/prompt_cache.zig
@@ -577,8 +577,24 @@ pub const Store = struct {
 
     /// One log line after a prompt pass: where it resumed, how many states it kept, and what the store holds.
     pub fn report(s: *const Store, prompt: usize, from: u32, kept: u64) void {
+        reportConv(s, prompt, from, kept, 0);
+    }
+
+    /// A conversation's key: the first CONV_TOKENS of the prompt, hashed. Stable across the turns of one
+    /// conversation (they share the system prompt and the history so far) and different between conversations,
+    /// which the reply's sha cannot be -- it hashes the reply and changes every turn. Without it, "this state
+    /// was lost" and "this is another conversation that only shares the system prefix" look identical.
+    pub const CONV_TOKENS = 2048;
+    pub fn convOf(tokens: []const u32) u64 {
+        var h = std.hash.Wyhash.init(0);
+        const n = @min(tokens.len, CONV_TOKENS);
+        h.update(std.mem.sliceAsBytes(tokens[0..n]));
+        return h.final();
+    }
+
+    pub fn reportConv(s: *const Store, prompt: usize, from: u32, kept: u64, conv: u64) void {
         if (@import("builtin").is_test) return;
-        std.log.info("prompt cache: {d} tokens, resumed at {d}, kept {d}; {d} states, {d} MiB and {d} MiB spare of {d} MiB (hits {d}, misses {d}, evicted {d}, refused {d}, failed {d})", .{ prompt, from, kept, s.entries.items.len, s.held >> 20, s.spare() >> 20, s.budget >> 20, s.counts.hits, s.counts.misses, s.counts.evicted, s.counts.refused, s.counts.failed });
+        std.log.info("prompt cache: {d} tokens, resumed at {d}, kept {d}, conv={x:0>16}; {d} states, {d} MiB and {d} MiB spare of {d} MiB (hits {d}, misses {d}, evicted {d}, refused {d}, failed {d})", .{ prompt, from, kept, conv, s.entries.items.len, s.held >> 20, s.spare() >> 20, s.budget >> 20, s.counts.hits, s.counts.misses, s.counts.evicted, s.counts.refused, s.counts.failed });
     }
 
