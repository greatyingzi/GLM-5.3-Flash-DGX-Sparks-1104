-        r.* = .{ .gpa = gpa, .family = family, .img = img, .root = root, .dir = dir, .keying = .{ .identity = id, .block = block_tokens, .lookahead = o.lookahead, .planned = o.planned }, .grid = o.grid, .cap = o.cap, .daily = o.daily, .admission = .{ .floor = o.floor }, .spill = o.spill };
+        r.* = .{ .gpa = gpa, .family = family, .img = img, .root = root, .dir = dir, .keying = .{ .identity = id, .block = block_tokens, .lookahead = o.lookahead, .planned = o.planned }, .grid = o.grid, .cap = o.cap, .daily = o.daily, .admission = .{ .floor = o.floor }, .spill = o.spill, .min_tokens = o.min_tokens };
         return r;
     }
 
diff --git a/zig/src/core/rows_write_sync.zig b/zig/src/core/rows_write_sync.zig
index f6c4b39..429f5ea 100644
--- a/zig/src/core/rows_write_sync.zig
+++ b/zig/src/core/rows_write_sync.zig
@@ -43,6 +43,13 @@ pub const Job = struct {
 
 /// A newly kept entry joins the queue (the RAM store calls this on every new keep), with the request's chunk starts.
 pub fn queued(r: *Rows, e: *pc.Entry, starts: []const u32) void {
+    // TF_LEARN_MIN_TOKENS: a short state re-prefills in seconds, so writing it spends the daily budget and the
+    // store's room that a 500k state needs to survive a restart (2026-11-16: 90 of 90 saves were refused with
+    // DailyBudgetSpent, the store sat at 117 of 120 GiB, and 15 cold refills cost 1,392 s of TTFT in two hours).
+    if (r.min_tokens > 0 and e.tokens.len < r.min_tokens) {
+        pc.note("imprint: saving {d} tokens skipped (TooSmall)", .{e.at});
+        return;
+    }
     const own = rows_store.startsBelow(r, r.gpa, starts, e.at) catch return;
     r.queue.append(r.gpa, .{ .entry = e, .starts = own }) catch r.gpa.free(own);
 }
