@@ -134,6 +136,13 @@ pub const Rows = struct {
                 const gibs = std.fmt.parseFloat(f64, trimmed) catch 0;
                 if (gibs >= 1 and gibs <= 64) r.staging_bytes = @intFromFloat(gibs * (1 << 30));
             }
+        }
+        // TF_LEARN_MIN_TOKENS: a state shorter than this is never written. A 16k-token state costs ~130 MiB and
